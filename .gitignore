# Operating systems
.DS_Store
Thumbs.db

# Editor-local state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.trash/
.vscode/
.idea/

# AI agent sessions and logs (may contain prompts, paths, or private context)
.claude/
.gjc/
.omx/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets.*

# Temporary files
*.tmp
*.swp
*~

# _tools/algo: local Cargo package generated by `algo sync` (machine-specific)
content/algorithms/problem-solving/Cargo.toml
content/algorithms/problem-solving/Cargo.lock
content/algorithms/problem-solving/.cargo/
rust-project.json

# Build output (algo builds to /tmp/algo-build; these catch manual builds)
target/
*.o
*.out
a.out
*.dSYM/
*.exe

# clangd index and compilation databases
.cache/
compile_commands.json
